JOB_HUNT_ENVIRONMENT=development
JOB_HUNT_DEBUG=false
JOB_HUNT_REGISTRY_PATH=config/users.toml
JOB_HUNT_ARTIFACT_ROOT=runs
JOB_HUNT_REDIS_URL=redis://redis:6379/0
JOB_HUNT_OPERATOR_TOKEN=replace-me
JOB_HUNT_DISCOVERY_SNAPSHOT_TTL_SECONDS=7200
JOB_HUNT_LLM_CHECKPOINT_TTL_SECONDS=604800
JOB_HUNT_LLM_PARALLELISM=3
JOB_HUNT_SCHEDULER_TIMEZONE=America/Edmonton

JOB_HUNT_TASK_SOFT_TIME_LIMIT_SECONDS=0
JOB_HUNT_TASK_TIME_LIMIT_SECONDS=0
JOB_HUNT_LITELLM_REQUEST_TIMEOUT_SECONDS=180
JOB_HUNT_TELEGRAM_REQUEST_TIMEOUT_SECONDS=120
JOB_HUNT_BASEROW_REQUEST_TIMEOUT_SECONDS=60
JOB_HUNT_LATEX_COMPILE_TIMEOUT_SECONDS=180
JOB_HUNT_JOB_LOCK_TIMEOUT_SECONDS=1800
JOB_HUNT_TASK_MAX_RETRIES=8
JOB_HUNT_RATE_LIMIT_FALLBACK_SECONDS=65
JOB_HUNT_TRANSIENT_BASE_DELAY_SECONDS=5
JOB_HUNT_TRANSIENT_MAX_DELAY_SECONDS=300

FAST_WORKER_CONCURRENCY=3
DOCUMENT_WORKER_CONCURRENCY=1
NOTIFICATION_WORKER_CONCURRENCY=1

JOB_HUNT_APIFY_TOKENS=apify-token-1,apify-token-2

# Job-hunt workers know only the internal LiteLLM gateway. Provider credentials stay below
# and are consumed only by the LiteLLM service through config/litellm.yaml.
JOB_HUNT_LITELLM_BASE_URL=http://litellm:4000
JOB_HUNT_LITELLM_API_KEY=replace-with-the-same-secret-as-LITELLM_MASTER_KEY
JOB_HUNT_LLM_ROUTES=groq-gpt-oss,gemini-flash,gemini-flash-lite
JOB_HUNT_LLM_REPAIR_ROUTES=gemini-flash-lite,groq-gpt-oss

LITELLM_MASTER_KEY=replace-with-a-long-random-secret

# Add/remove provider credentials here and corresponding deployment entries in config/litellm.yaml.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

JOB_HUNT_TELEGRAM_BOT_TOKEN=
JOB_HUNT_TELEGRAM_WEBHOOK_SECRET=

JOB_HUNT_PROVIDER_QUOTA_COOLDOWN_SECONDS=3600

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

FLOWER_BASIC_AUTH=

MAHSA_BASEROW_TOKEN=
MAHSA_FILLOUT_WEBHOOK_SECRET=

MOJTABA_BASEROW_TOKEN=
MOJTABA_FILLOUT_WEBHOOK_SECRET=
