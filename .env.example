JOB_HUNT_ENVIRONMENT=development
JOB_HUNT_REGISTRY_PATH=config/users.toml
JOB_HUNT_ARTIFACT_ROOT=runs
JOB_HUNT_REDIS_URL=redis://redis:6379/0
JOB_HUNT_OPERATOR_TOKEN=replace-me
JOB_HUNT_DISCOVERY_SNAPSHOT_TTL_SECONDS=7200
JOB_HUNT_LLM_CHECKPOINT_TTL_SECONDS=604800
JOB_HUNT_LLM_PARALLELISM=3

# Shared capacity pools used by every tenant. Each key belongs to a separate account.
JOB_HUNT_APIFY_TOKENS=apify-token-1,apify-token-2
JOB_HUNT_GEMINI_API_KEYS=gemini-key-1,gemini-key-2

# Main generation exhausts every account on each model before moving down this ordered list.
JOB_HUNT_GEMINI_CONTENT_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
JOB_HUNT_GEMINI_REPAIR_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
JOB_HUNT_PROVIDER_QUOTA_COOLDOWN_SECONDS=3600

# Optional override for proactive per-account, per-model RPM/TPM/RPD budgeting.
# JOB_HUNT_GEMINI_LIMITS_JSON={"gemini-3.6-flash":{"rpm":5,"tpm":250000,"rpd":20}}

# Optional Langfuse tracing. Leave blank to disable tracing without changing code.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Optional Flower UI protection. Example: admin:change-me
FLOWER_BASIC_AUTH=

MAHSA_BASEROW_TOKEN=
MAHSA_TELEGRAM_BOT_TOKEN=
MAHSA_TELEGRAM_WEBHOOK_SECRET=
MAHSA_FILLOUT_WEBHOOK_SECRET=

MOJTABA_BASEROW_TOKEN=
MOJTABA_TELEGRAM_BOT_TOKEN=
MOJTABA_TELEGRAM_WEBHOOK_SECRET=
MOJTABA_FILLOUT_WEBHOOK_SECRET=
