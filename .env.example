JOB_HUNT_ENVIRONMENT=development
JOB_HUNT_DEBUG=false
JOB_HUNT_REGISTRY_PATH=config/users.toml
JOB_HUNT_ARTIFACT_ROOT=runs
JOB_HUNT_REDIS_URL=redis://redis:6379/0
JOB_HUNT_OPERATOR_TOKEN=replace-me
JOB_HUNT_DISCOVERY_SNAPSHOT_TTL_SECONDS=7200
JOB_HUNT_LLM_CHECKPOINT_TTL_SECONDS=604800
JOB_HUNT_LLM_PARALLELISM=3
JOB_HUNT_SCHEDULER_TIMEZONE=America/Edmonton

JOB_HUNT_TASK_SOFT_TIME_LIMIT_SECONDS=0
JOB_HUNT_TASK_TIME_LIMIT_SECONDS=0
JOB_HUNT_LITELLM_REQUEST_TIMEOUT_SECONDS=180
JOB_HUNT_TELEGRAM_REQUEST_TIMEOUT_SECONDS=120
JOB_HUNT_BASEROW_REQUEST_TIMEOUT_SECONDS=60
JOB_HUNT_LATEX_COMPILE_TIMEOUT_SECONDS=180
JOB_HUNT_JOB_LOCK_TIMEOUT_SECONDS=1800
JOB_HUNT_TASK_MAX_RETRIES=8
JOB_HUNT_RATE_LIMIT_FALLBACK_SECONDS=65
JOB_HUNT_TRANSIENT_BASE_DELAY_SECONDS=5
JOB_HUNT_TRANSIENT_MAX_DELAY_SECONDS=300

FAST_WORKER_CONCURRENCY=3
DOCUMENT_WORKER_CONCURRENCY=1
NOTIFICATION_WORKER_CONCURRENCY=1

JOB_HUNT_APIFY_TOKENS=apify-token-1,apify-token-2

# Workers call only capability groups exposed by the internal LiteLLM gateway.
JOB_HUNT_LITELLM_BASE_URL=http://litellm:4000
JOB_HUNT_LITELLM_API_KEY=replace-with-the-same-secret-as-LITELLM_MASTER_KEY
JOB_HUNT_LLM_ROUTES=job-fast,job-balanced,job-powerful
JOB_HUNT_LLM_REPAIR_ROUTES=job-fast,job-balanced
JOB_HUNT_LLM_DEFAULT_GROUP=job-balanced
JOB_HUNT_LLM_REPAIR_GROUP=job-fast

# Optional exact operation overrides. Keys are matched against prompt operation names.
# JOB_HUNT_LLM_OPERATION_GROUPS_JSON={"compatibility":"job-fast","qualification":"job-balanced","cover_letter":"job-powerful"}

LITELLM_MASTER_KEY=replace-with-a-long-random-secret
LITELLM_COOLDOWN_SECONDS=65
LITELLM_ROUTING_STRATEGY=simple-shuffle
LITELLM_CONFIG_PATH=config/litellm.runtime.yaml

# Groq model discovery runs during deployment. Every discovered chat model is assigned to
# fast/balanced/powerful by a conservative size heuristic. Explicit lists override classification.
LITELLM_GROQ_DISCOVER_MODELS=true
LITELLM_GROQ_FAST_MODELS=
LITELLM_GROQ_BALANCED_MODELS=
LITELLM_GROQ_POWERFUL_MODELS=

# Gemini remains curated because its API catalog contains families/capabilities that should not
# automatically be treated as interchangeable structured-output chat models.
LITELLM_GEMINI_FAST_MODELS=gemini-3.5-flash-lite
LITELLM_GEMINI_BALANCED_MODELS=gemini-3.5-flash
LITELLM_GEMINI_POWERFUL_MODELS=gemini-3.5-flash

# Add as many numbered provider keys as needed. The generator expands every key across each
# compatible model in that provider's capability pool.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

JOB_HUNT_TELEGRAM_BOT_TOKEN=
JOB_HUNT_TELEGRAM_WEBHOOK_SECRET=

JOB_HUNT_PROVIDER_QUOTA_COOLDOWN_SECONDS=3600

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

FLOWER_BASIC_AUTH=

MAHSA_BASEROW_TOKEN=
MAHSA_FILLOUT_WEBHOOK_SECRET=

MOJTABA_BASEROW_TOKEN=
MOJTABA_FILLOUT_WEBHOOK_SECRET=
