JOB_HUNT_ENVIRONMENT=development
JOB_HUNT_REGISTRY_PATH=config/users.toml
JOB_HUNT_ARTIFACT_ROOT=runs
JOB_HUNT_REDIS_URL=redis://redis:6379/0
JOB_HUNT_OPERATOR_TOKEN=replace-me
JOB_HUNT_DISCOVERY_SNAPSHOT_TTL_SECONDS=7200
JOB_HUNT_LLM_CHECKPOINT_TTL_SECONDS=604800
JOB_HUNT_LLM_PARALLELISM=3

# Automatic discovery runs on clock-hour boundaries in this timezone.
# America/Edmonton is Calgary time and automatically follows MST/MDT daylight saving changes.
JOB_HUNT_SCHEDULER_TIMEZONE=America/Edmonton

# Operational timeouts and retry controls.
# Whole Celery task deadlines are disabled by default so a document job may run for several minutes.
# Set these two to positive values only if you intentionally want Celery to terminate long tasks.
JOB_HUNT_TASK_SOFT_TIME_LIMIT_SECONDS=0
JOB_HUNT_TASK_TIME_LIMIT_SECONDS=0
JOB_HUNT_GEMINI_REQUEST_TIMEOUT_SECONDS=180
JOB_HUNT_TELEGRAM_REQUEST_TIMEOUT_SECONDS=120
JOB_HUNT_BASEROW_REQUEST_TIMEOUT_SECONDS=60
JOB_HUNT_LATEX_COMPILE_TIMEOUT_SECONDS=180
JOB_HUNT_JOB_LOCK_TIMEOUT_SECONDS=1800
JOB_HUNT_TASK_MAX_RETRIES=8
JOB_HUNT_RATE_LIMIT_FALLBACK_SECONDS=65
JOB_HUNT_TRANSIENT_BASE_DELAY_SECONDS=5
JOB_HUNT_TRANSIENT_MAX_DELAY_SECONDS=300

# Celery worker concurrency, set separately per queue (docker-compose.yml).
# Document generation already performs bounded internal Gemini parallelism, so
# keep document task concurrency at 1 until observed provider capacity supports more.
FAST_WORKER_CONCURRENCY=3
DOCUMENT_WORKER_CONCURRENCY=1
NOTIFICATION_WORKER_CONCURRENCY=1

# Shared capacity pools used by every tenant. Each key belongs to a separate account.
JOB_HUNT_APIFY_TOKENS=apify-token-1,apify-token-2
JOB_HUNT_GEMINI_API_KEYS=gemini-key-1,gemini-key-2

# One Telegram bot serves every tenant. Tenant routing uses each tenant's telegram_chat_id.
JOB_HUNT_TELEGRAM_BOT_TOKEN=
JOB_HUNT_TELEGRAM_WEBHOOK_SECRET=

# Main generation exhausts every account on each model before moving down this ordered list.
JOB_HUNT_GEMINI_CONTENT_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
JOB_HUNT_GEMINI_REPAIR_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# Generic provider cooldown remains conservative for services such as Apify.
JOB_HUNT_PROVIDER_QUOTA_COOLDOWN_SECONDS=3600

# Generic Gemini 429s without a provider-supplied retry time should release quickly.
# Explicit RPM/TPM limits use the next minute and daily quota errors use the real daily reset.
JOB_HUNT_GEMINI_QUOTA_COOLDOWN_SECONDS=65

# Optional override for proactive per-account, per-model RPM/TPM/RPD budgeting.
# These limits are enforced through Redis across all worker processes, not per worker.
# JOB_HUNT_GEMINI_LIMITS_JSON={"gemini-3.6-flash":{"rpm":5,"tpm":250000,"rpd":20}}

# Optional Langfuse tracing. Leave blank to disable tracing without changing code.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Optional Flower UI protection. Example: admin:change-me
FLOWER_BASIC_AUTH=

MAHSA_BASEROW_TOKEN=
MAHSA_FILLOUT_WEBHOOK_SECRET=

MOJTABA_BASEROW_TOKEN=
MOJTABA_FILLOUT_WEBHOOK_SECRET=
